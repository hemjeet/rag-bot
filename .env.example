# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI (used for embeddings and, optionally, generation)
OPENAI_API_KEY=''
# Optional: only needed if you want DeepSeek for generation
DEEPSEEK_API_KEY=''
DEEPSEEK_BASE_URL='https://api.deepseek.com'

# AWS S3 Bucket (for multimodal image assets)
S3_BUCKET_NAME=''

# Required PostgreSQL connection string
DATABASE_URL='postgresql://user:password@host:5432/database_name'

# --- Optional tuning ---
# EMBEDDING_MODEL='text-embedding-3-small'
# EMBEDDING_DIMENSION=1536
# DENSE_TOP_K=10
# SPARSE_TOP_K=10
# RRF_K=60
# HYBRID_TOP_N=5
# LLM_MODEL=''
# ROUTER_MODEL=''
# LLM_TEMPERATURE=0.0
# DEFAULT_COLLECTION='legal_documents'
# VECTOR_TABLE_NAME='test_multimodal_chunks'
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=6

# --- Workers (mutually exclusive with reload) ---
# WORKERS=4
